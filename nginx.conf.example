# Configuration Nginx pour Work&You
# Fichier: /etc/nginx/sites-available/workandyou

server {
    listen 80;
    server_name VOTRE-DOMAINE.com www.VOTRE-DOMAINE.com;

    # Redirection vers HTTPS (décommenter après avoir configuré le certificat SSL)
    # return 301 https://$server_name$request_uri;

    # Configuration temporaire HTTP (avant SSL)
    # À SUPPRIMER après installation du certificat SSL
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        
        # Taille max des uploads (pour les signatures)
        client_max_body_size 20M;
    }

    # Logs
    access_log /var/log/nginx/workandyou-access.log;
    error_log /var/log/nginx/workandyou-error.log;
}

# Configuration HTTPS (sera générée automatiquement par Certbot)
# Après avoir exécuté: sudo certbot --nginx -d VOTRE-DOMAINE.com -d www.VOTRE-DOMAINE.com
# 
# Certbot ajoutera automatiquement :
# - Le bloc server écoute sur le port 443
# - Les certificats SSL
# - La redirection HTTP → HTTPS dans le bloc ci-dessus


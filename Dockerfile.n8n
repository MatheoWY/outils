# Dockerfile pour n8n - Service d'automatisation workflow
# Image officielle n8n avec configuration pour production

FROM n8nio/n8n:latest

# Variables d'environnement par défaut
ENV N8N_BASIC_AUTH_ACTIVE=true
ENV N8N_BASIC_AUTH_USER=admin
ENV N8N_BASIC_AUTH_PASSWORD=changeme
ENV N8N_HOST=0.0.0.0
ENV N8N_PORT=5678
ENV N8N_PROTOCOL=http
ENV WEBHOOK_URL=http://localhost:5678/
ENV GENERIC_TIMEZONE=Europe/Paris
ENV N8N_METRICS=true

# Exposition du port n8n
EXPOSE 5678

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5678/healthz || exit 1

# L'image n8n a deja un ENTRYPOINT et CMD configures, on les garde


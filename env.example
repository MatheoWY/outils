# ====================================================
# CONFIGURATION RUNPOD (Méthode Work&You)
# ====================================================
# Laissez VIDE pour utiliser la SIMULATION
# Remplissez pour basculer automatiquement vers RunPod
RUNPOD_API_URL=
RUNPOD_API_KEY=

# ====================================================
# CONFIGURATION API PYTHON WORK&YOU
# ====================================================
WORKANDYOU_API_URL=http://localhost:8000

# ====================================================
# CONFIGURATION GITHUB (Upload signatures)
# ====================================================
GITHUB_PAT=
REPO_OWNER=MatheoWY
REPO_NAME=signatures
BRANCH=main

# ====================================================
# CONFIGURATION OAUTH GOOGLE (OBLIGATOIRE EN PRODUCTION)
# ====================================================
# Créer une application OAuth Google sur https://console.cloud.google.com/
# 1. Créer un projet
# 2. Activer Google+ API
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter les URI autorisées :
#    - Origines : https://votre-domaine.com
#    - Redirections : https://votre-domaine.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Générer avec: openssl rand -hex 32
SESSION_SECRET=
# Domaine email autorisé (seuls les @workandyou.fr peuvent se connecter)
ALLOWED_DOMAIN=workandyou.fr
# URL de callback OAuth (à adapter selon votre domaine de production)
GOOGLE_CALLBACK_URL=http://localhost:5174/auth/google/callback

# ====================================================
# CONFIGURATION SERVEUR
# ====================================================
NODE_ENV=development
PORT=5174

